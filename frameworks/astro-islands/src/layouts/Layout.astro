---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<nav>
			<a href="/">島のあるページ</a>
			<a href="/static">島のないページ</a>
		</nav>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--background: #ffffff;
		--foreground: #171717;
		--muted: #6b7280;
		--border: #e5e7eb;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--background: #0a0a0a;
			--foreground: #ededed;
			--muted: #9ca3af;
			--border: #262626;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--background);
		color: var(--foreground);
		font-family: system-ui, sans-serif;
		line-height: 1.7;
	}

	nav {
		display: flex;
		gap: 16px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--border);
	}

	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 24px 16px;
	}

	a {
		color: inherit;
	}

	section {
		margin: 24px 0;
		padding-top: 8px;
		border-top: 1px solid var(--border);
	}

	h2 {
		font-size: 1rem;
	}

	dt {
		color: var(--muted);
	}

	dd {
		margin: 0;
		font-family: ui-monospace, monospace;
	}

	button {
		font: inherit;
		padding: 4px 12px;
	}
</style>
